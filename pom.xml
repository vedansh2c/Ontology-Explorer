<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>ontology-tools</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ontology-tools</name>
    <description>Local RAG assistant for Apache Jena ontologies</description>

    <properties>
        <java.version>21</java.version>
        <jena.version>5.5.0</jena.version>
        <lucene.version>10.3.1</lucene.version>
        <copilot.version>1.0.17-preview.9</copilot.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.jena</groupId>
            <artifactId>apache-jena-libs</artifactId>
            <version>${jena.version}</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>org.apache.jena</groupId>
            <artifactId>jena-tdb2</artifactId>
            <version>${jena.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-common</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-queryparser</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github</groupId>
            <artifactId>copilot-sdk-java</artifactId>
            <version>${copilot.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github</groupId>
            <artifactId>copilot-sdk-java-runtime</artifactId>
            <version>${copilot.version}</version>
            <classifier>${copilot.runtime.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>3.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>copilot-runtime-darwin-arm64</id>
            <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
            <properties><copilot.runtime.classifier>darwin-arm64</copilot.runtime.classifier></properties>
        </profile>
        <profile>
            <id>copilot-runtime-darwin-x64</id>
            <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
            <properties><copilot.runtime.classifier>darwin-x64</copilot.runtime.classifier></properties>
        </profile>
        <profile>
            <id>copilot-runtime-win32-x64</id>
            <activation><os><family>windows</family><arch>amd64</arch></os></activation>
            <properties><copilot.runtime.classifier>win32-x64</copilot.runtime.classifier></properties>
        </profile>
        <profile>
            <id>copilot-runtime-win32-arm64</id>
            <activation><os><family>windows</family><arch>aarch64</arch></os></activation>
            <properties><copilot.runtime.classifier>win32-arm64</copilot.runtime.classifier></properties>
        </profile>
        <profile>
            <id>copilot-runtime-linux-x64</id>
            <activation><os><family>unix</family><name>Linux</name><arch>amd64</arch></os></activation>
            <properties><copilot.runtime.classifier>linux-x64</copilot.runtime.classifier></properties>
        </profile>
        <profile>
            <id>copilot-runtime-linux-arm64</id>
            <activation><os><family>unix</family><name>Linux</name><arch>aarch64</arch></os></activation>
            <properties><copilot.runtime.classifier>linux-arm64</copilot.runtime.classifier></properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
